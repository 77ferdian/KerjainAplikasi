<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorBorder"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_talent_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#4F46E5"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/tv_talent_avatar_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="F"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:gravity="center" />

            <ImageView
                android:id="@+id/iv_talent_avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_talent_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="Ferdian"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-black"
            app:layout_constraintTop_toTopOf="@id/card_talent_avatar"
            app:layout_constraintBottom_toTopOf="@id/tv_talent_school"
            app:layout_constraintStart_toEndOf="@id/card_talent_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_talent_school"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TI • ITS • Product Management"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_talent_name"
            app:layout_constraintBottom_toBottomOf="@id/card_talent_avatar"
            app:layout_constraintStart_toStartOf="@id/tv_talent_name"
            app:layout_constraintEnd_toEndOf="@id/tv_talent_name" />

        <TextView
            android:id="@+id/tv_talent_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Average Score Layout -->
        <LinearLayout
            android:id="@+id/layout_talent_average"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="rata-rata"
                android:textColor="@color/colorTextSecondary"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tv_talent_average_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="95"
                android:textColor="@color/colorPrimary"
                android:textSize="24sp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_talent_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_talent_school" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
