<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorBorder"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_task_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F3F0FF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                android:id="@+id/tv_item_partner_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="KJ"
                android:textColor="@color/colorTextPrimary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-black"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Judul Program"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-bold"
            app:layout_constraintTop_toTopOf="@id/card_task_logo"
            app:layout_constraintStart_toEndOf="@id/card_task_logo"
            app:layout_constraintEnd_toStartOf="@id/tv_item_status" />

        <TextView
            android:id="@+id/tv_item_partner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Partner • Deadline hari ini"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/tv_item_title"
            app:layout_constraintStart_toStartOf="@id/tv_item_title"
            app:layout_constraintEnd_toEndOf="@id/tv_item_title" />

        <TextView
            android:id="@+id/tv_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proses"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_badge_primary"
            android:backgroundTint="#FFF3E0"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>