<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_sub_student_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Budi Santoso"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sub_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menunggu Review"
                android:textColor="@color/colorInfo"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_primary"
                android:backgroundTint="#EBF5FB"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sub_program_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android Developer Internship"
            android:textColor="@color/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_sub_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tugas: Setup Project &amp; Git"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_sub_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catatan: Sudah push ke github kak..."
            android:textColor="@color/colorTextSecondary"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
