<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorDivider"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Task Number Circle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_number"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F3F0FF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_task_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="1"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Task Info -->
        <TextView
            android:id="@+id/tv_task_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:text="Setup Project &amp; Git"
            android:textColor="@color/colorTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="@id/card_number"
            app:layout_constraintStart_toEndOf="@id/card_number"
            app:layout_constraintEnd_toStartOf="@id/tv_task_item_status" />

        <TextView
            android:id="@+id/tv_task_item_deadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Batas: 2026-07-07"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tv_task_item_title"
            app:layout_constraintStart_toStartOf="@id/tv_task_item_title"
            app:layout_constraintEnd_toEndOf="@id/tv_task_item_title" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_task_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BELUM DIKIRIM"
            android:textColor="@color/colorTextSecondary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:background="@drawable/bg_badge_primary"
            android:backgroundTint="#F8F9FA"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
