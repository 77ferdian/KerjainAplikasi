<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/colorDivider"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F3F0FF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/card_logo_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_today"
                android:contentDescription="Program Icon"
                app:tint="@color/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Android Developer Internship"
            android:textColor="@color/colorTextPrimary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="@id/card_logo"
            app:layout_constraintStart_toEndOf="@id/card_logo"
            app:layout_constraintEnd_toStartOf="@id/tv_item_status" />

        <TextView
            android:id="@+id/tv_item_partner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="GoTo Group"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tv_item_title"
            app:layout_constraintStart_toStartOf="@id/tv_item_title"
            app:layout_constraintEnd_toEndOf="@id/tv_item_title" />

        <TextView
            android:id="@+id/tv_item_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Published"
            android:textColor="@color/colorSuccess"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:background="@drawable/bg_badge_primary"
            android:backgroundTint="#D1F2EB"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorDivider"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/card_logo" />

        <TextView
            android:id="@+id/tv_item_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ANDROID"
            android:textColor="@color/colorPrimary"
            android:textSize="10sp"
            android:fontFamily="sans-serif-black"
            android:background="@drawable/bg_badge_primary"
            android:backgroundTint="#F0EEFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mulai Jul 2026"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/tv_item_category"
            app:layout_constraintBottom_toBottomOf="@id/tv_item_category"
            app:layout_constraintStart_toEndOf="@id/tv_item_category" />

        <TextView
            android:id="@+id/tv_item_quota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kuota: 20"
            android:textColor="@color/colorTextPrimary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toTopOf="@id/tv_item_category"
            app:layout_constraintBottom_toBottomOf="@id/tv_item_category"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
